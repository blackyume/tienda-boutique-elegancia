rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'laboutiquedelaeleganciaoficial@gmail.com',
          'juampi218@gmail.com'
        ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // --- PUBLIC CATALOG (read-all, admin-write) ---
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_provinces/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- ADMIN-ONLY BUSINESS OPS ---
    match /suppliers/{id} {
      allow read, write: if isAdmin();
    }

    match /simulations/{id} {
      allow read, write: if isAdmin();
    }

    match /scheduled_promotions/{id} {
      allow read, write: if isAdmin();
    }

    match /ai_history/{id} {
      allow read, write: if isAdmin();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // --- ORDERS ---
    // Usuarios pueden crear sus propias órdenes y leer las propias.
    // Admin puede leer/editar/eliminar todas.
    match /orders/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- USERS ---
    // Cada usuario maneja su propio documento. Admin puede leer todos.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      // El usuario edita su doc pero NO puede auto-escalar rol ni inflar
      // sus métricas de referidos (eso solo lo escribe el server con Admin SDK).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('referralsEarnings', 0) == resource.data.get('referralsEarnings', 0)
        && request.resource.data.get('referralsCount', 0) == resource.data.get('referralsCount', 0)
        && request.resource.data.get('referralsRevenue', 0) == resource.data.get('referralsRevenue', 0);
      allow delete: if isAdmin();
    }

    // --- REVIEWS ---
    // Todos ven reviews; solo usuarios autenticados crean con approved=false;
    // admin modera (puede aprobar/borrar).
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- WISHLIST EVENTS ---
    // Log público de eventos — cualquiera puede crear (sin datos sensibles).
    // Solo admin lee/modera.
    match /wishlist_events/{id} {
      allow read: if isAdmin();
      // Endurecido: solo eventos con acción válida (anti-spam de la colección).
      allow create: if request.resource.data.action in ['add', 'remove'];
      allow update, delete: if isAdmin();
    }

    // --- STATS / VISITS ---
    // Cualquiera incrementa; solo admin lee/edita.
    match /stats/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- ABANDONED CARTS ---
    // Cualquiera crea/actualiza su propio "carrito abandonado" (pre-compra).
    // Sólo admin lee/modera/borra.
    match /abandoned_carts/{id} {
      allow read: if isAdmin();
      // Endurecido: requiere email (string acotado) e items (lista). Coincide con
      // lo que escribe el cliente (utils/abandonedCart.js); bloquea docs basura.
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.size() <= 256
        && request.resource.data.items is list;
      allow delete: if isAdmin();
    }

    // --- ACTIVE SESSIONS (presence) ---
    // Cualquiera registra/actualiza su sesión (lastSeen) para métricas live.
    // Sólo admin lee agregados; público puede borrar la propia al salir.
    match /active_sessions/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if true;
    }

    // --- VISIT STATS HOURLY ---
    // Counters por hora. Cualquiera incrementa; admin lee/borra.
    match /visit_stats_hourly/{id} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- NEWSLETTER SUBSCRIBERS ---
    // Cualquiera se suscribe (crea/actualiza su email); sólo admin lee/borra.
    match /newsletter_subscribers/{id} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow delete: if isAdmin();
    }

    // --- PUSH SUBSCRIPTIONS (FCM) ---
    // Cualquiera registra su token; sólo admin lee/elimina agregados.
    match /push_subscriptions/{id} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Default deny — toda ruta no declarada queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
